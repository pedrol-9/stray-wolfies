# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Opcional: mismos valores con nombres del asistente de Supabase
# SUPABASE_URL=
# SUPABASE_KEY=

# Solo servidor (.env / .env.local). Nunca en Git ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Panel /admin — abrir o cerrar pedidos
ADMIN_PIN=

# WhatsApp — botón "Enviar resumen" en admin (solo dígitos, ej. 573001234567)
PUBLIC_OWNER_WHATSAPP=

# Webhook al crear pedido (Make / Zapier / n8n) → módulo WhatsApp
ORDER_WEBHOOK_URL=

# Email (opcional)
RESEND_API_KEY=
OWNER_EMAIL=
